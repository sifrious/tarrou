{
    "name": "sifrious/tarrou",
    "description": "Public OSS package for DNS desired-state planning.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Tarrou\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tarrou\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always"
    }
}
